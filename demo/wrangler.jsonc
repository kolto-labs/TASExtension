// Static-assets Worker for the InputInterfaceTelos browser prototype.
// Wine root zip delivery streams bounded public chunks; other assets stay static.
{
  "name": "kptas-demo",
  "compatibility_date": "2026-09-01",
  "main": "./worker/wine-root.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/original-game/wine-roots/*"],
    "not_found_handling": "single-page-application"
  }
}
