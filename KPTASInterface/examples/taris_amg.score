#!score v1 game=k1 build=auto tier=tas hz=60 start=save:9f3c41d2 render=800x600/low
# Taris apartment: Save Teleport, then AMG. Each note lists every held input.
# Adapted from the design spec example for 60 Hz: hold lengths and timeouts
# are doubled, and one-tick taps stay one tick.
@include ../lib/k1-keymap.score      # $qsave and $pause, read from the local install
@segment open scale=100 pace=gate
@sync area.ready timeout=1800
4   w
24  w lmb rmb                        # both buttons: run
1   w lmb rmb $qsave                 # quick save while running
@sync save.begin
16  .
@sync save.done
@mark after_teleport
@segment amg hz=25                   # 40 ms frame widens the save window
1   esc
@sync gui.open saveload
1   m@412,188 lmb                    # slot 1
@sync save.begin
1   !altf4                           # AMG: close mid-save
@expect exit|alive timeout=120
@relaunch if=exit
@segment reload                      # back to the header rate
@sync main_menu timeout=7200
# Load slot 1. These menu positions are placeholders, not checked in game.
1   m@400,330 lmb                    # Load Game
@sync gui.open saveload
1   m@412,188 lmb                    # slot 1
1   .
1   m@640,560 lmb                    # Load
@sync load.done
1   esc                              # unpause into menu control
@repeat 3
  1   $pause
  1   .                              # release, so the next press counts
@end
