+        ++keyButtonTransitions;
+    }
+    if (pressedButtons & 1U) {
+        boxedwineEmscriptenMouseButton(1U, 0U, pointX, pointY);
+        ++transitions;
+        ++keyButtonTransitions;
+    }
+    if (pressedButtons & 2U) {
+        boxedwineEmscriptenMouseButton(1U, 1U, pointX, pointY);
