+
+void KTimer::updateExpirationsLocked(U64 now) {
+    if (!microNextTimer || microNextTimer > now) {
+        return;
+    }
+    U64 expirations = 1;
+    if (microInterval) {
+        expirations += (now - microNextTimer) / microInterval;
