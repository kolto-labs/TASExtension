+bool KOpenGLSdl::glRestoreCurrentContext(KThread* thread) {
+    if (!thread->currentContext) {
+#ifdef BOXEDWINE_GL4ES
+        kwarn_fmt("GL4ES guest-context restore rejected: reason=unbound thread=%llu hostContext=%lu",
+                (unsigned long long)thread->id,
+                (unsigned long)emscripten_webgl_get_current_context());
+        return false; // An unbound guest must not borrow another guest's state.
+#else
+        return true;
+#endif
+    }
+    SDLGlContextPtr context = contextsById.get(thread->currentContext);
+    if (!context || !context->context) {
+#ifdef BOXEDWINE_GL4ES
+        kwarn_fmt("GL4ES guest-context restore rejected: reason=missing-context guest=%u record=%p native=%p hostContext=%lu thread=%llu",
+                thread->currentContext, (void*)context.get(), context ? (void*)context->context : nullptr,
+                (unsigned long)emscripten_webgl_get_current_context(),
+                (unsigned long long)thread->id);
+#endif
+        return false;
+    }
+    EMSCRIPTEN_WEBGL_CONTEXT_HANDLE handle = context->webglContext
+            ? toWebGLContext(context->context) : context->sdlWebGLContext;
+    if (!handle) {
+#ifdef BOXEDWINE_GL4ES
+        kwarn_fmt("GL4ES guest-context restore rejected: reason=missing-webgl-handle guest=%u record=%p native=%p webgl=%d sdlHandle=%lu state=%p thread=%llu",
+                thread->currentContext, (void*)context.get(), (void*)context->context, context->webglContext,
+                (unsigned long)context->sdlWebGLContext,
+                (void*)context->translatorState, (unsigned long long)thread->id);
+#endif
+        return false;
+    }
+    if (emscripten_webgl_get_current_context() == handle) {
+#ifdef BOXEDWINE_GL4ES
+        if (!boxedwineWebGLContextAlive(handle)) {
+            kwarn_fmt("GL4ES guest-context restore rejected: reason=host-context-lost guest=%u handle=%lu state=%p thread=%llu",
+                    thread->currentContext, (unsigned long)handle,
+                    (void*)context->translatorState, (unsigned long long)thread->id);
+            return false;
+        }
+        if (!context->translatorState) {
+            kwarn_fmt("GL4ES guest-context restore rejected: reason=missing-translator-state guest=%u handle=%lu thread=%llu",
+                    thread->currentContext, (unsigned long)handle,
+                    (unsigned long long)thread->id);
+            return false;
+        }
+        ActivateGLState(context->translatorState);
+#endif
+        return true;
+    }
+    // SDL's EGL handle is opaque and need not identify the WebGL context.
+    // Select the saved WebGL handle without recreating a drawable or trusting
+    // SDL's cached current-window/context pair after another guest thread ran.
+    const auto restoreResult = BOXEDWINE_PROFILE_WEBGL_BINDING(boxedwineMakeWebGLContextCurrent(handle));
+    bool restored = restoreResult == EMSCRIPTEN_RESULT_SUCCESS
+            && emscripten_webgl_get_current_context() == handle;
+    if (!restored) {
+#ifdef BOXEDWINE_GL4ES
+        kwarn_fmt("Could not restore guest GL context %u (WebGL handle %lu, current %lu, result %d, owner %llu, caller %llu)",
+                thread->currentContext, (unsigned long)handle,
+                (unsigned long)emscripten_webgl_get_current_context(), restoreResult,
+                (unsigned long long)context->webglOwnerThread, (unsigned long long)SDL_ThreadID());
+#else
+        kwarn_fmt("Could not restore guest GL context %u", thread->currentContext);
+#endif
+    }
+#ifdef BOXEDWINE_GL4ES
+    if (restored) {
+        if (!context->translatorState) {
+            kwarn_fmt("GL4ES guest-context restore rejected: reason=missing-translator-state-after-bind guest=%u handle=%lu thread=%llu",
+                    thread->currentContext, (unsigned long)handle,
+                    (unsigned long long)thread->id);
+            return false;
+        }
+        ActivateGLState(context->translatorState);
+    }
+#endif
+    return restored;
+}
