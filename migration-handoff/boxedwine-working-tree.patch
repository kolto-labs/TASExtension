+        // dispatcher turn instead of dropping missed intervals.
+        U64 untilNext = microInterval - ((now - microNextTimer) % microInterval);
+        const U64 maxTime = ~(U64)0;
+        microNextTimer = untilNext > maxTime - now ? maxTime : now + untilNext;
+    } else {
+        microNextTimer = 0;
+    }
+    const U64 maxCount = ~(U64)0;
+    U64 count = numberOfExpirations.load();
+    numberOfExpirations.store(expirations > maxCount - count
+        ? maxCount : count + expirations);
+    BOXEDWINE_CONDITION_SIGNAL_ALL(waitCond);
+}
+
+void KTimer::scheduleLocked(U64 now) {
+    U64 remaining = microNextTimer > now ? microNextTimer - now : 0;
+    U64 millies = remaining / 1000 + (remaining % 1000 != 0);
+    // Bound each checkpoint and recheck the U64 deadline before expiration.
+    // The scheduler still compares unsigned absolute U32 ticks: a checkpoint
+    // crossing tick rollover can cause repeated dispatch until ticks wrap.
+    // Full rollover handling requires changing the shared scheduler contract.
+    timer.millies = KSystem::getMilliesSinceStart() + (U32)std::min<U64>(millies, 0x3fffffff);
