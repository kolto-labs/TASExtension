 void KNativeSystem::exit(const char* msg, U32 code) {
+#ifdef __EMSCRIPTEN__
+    // The BoxedWine runtime executes on a pthread worker, where browser alert()
+    // is unavailable. Forward fatal guest errors to the runtime's main-thread
+    // status bridge so the owning page can show the actual message.
+    MAIN_THREAD_EM_ASM({
+        const text = UTF8ToString($0);
+        if (typeof notifyOwnedGameStatus === 'function') {
+            notifyOwnedGameStatus('error', text);
+        } else {
+            console.error(text);
+        }
+    }, msg);
+#else
     SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "Error", msg, nullptr);
+#endif
